rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── USERS ──
    // Users can only read/write their own document.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, delete: if request.auth != null && request.auth.uid == userId;
      // IAP bug guard: reject any update that sets `appleProductId` to the app
      // bundle id. On iOS, StoreKit replays an app-receipt pseudo-transaction
      // (product id = the bundle id) on launch, and the client marked that as a
      // Pro purchase — upgrading every iOS user for free. Real purchases carry
      // the IAP product id (dugoutiq_pro_lifetime); Stripe fulfillment runs
      // through the Admin SDK, which bypasses these rules. We block exactly the
      // bug's fingerprint — a resulting doc that is BOTH plan==pro AND
      // appleProductId==bundle id — so ordinary profile updates and
      // legitimately-Pro users (Stripe/Google/real IAP) are unaffected.
      allow update: if request.auth != null && request.auth.uid == userId
        && !(request.resource.data.get('plan', '') == 'pro'
             && request.resource.data.get('appleProductId', '') == 'com.studiopabst.dugoutiq');
    }

    // ── TEAMS ──
    // Only the head coach or assistant coaches can access team data
    match /teams/{teamId} {
      // Helper: is this user a member of this team?
      function isTeamMember() {
        return request.auth != null && (
          resource.data.coachId == request.auth.uid ||
          ('assistantIds' in resource.data && request.auth.uid in resource.data.assistantIds)
        );
      }

      // Anyone authenticated can create a team (they become coachId)
      allow create: if request.auth != null;
      // Team members can read/update, portal users can read (PIN validated in app)
      allow read: if isTeamMember() || true;
      allow update: if isTeamMember();
      // Only head coach can delete
      allow delete: if request.auth != null && resource.data.coachId == request.auth.uid;

      // ── PLAYERS subcollection ──
      match /players/{playerId} {
        allow read: if true;
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/teams/$(teamId)).data.coachId == request.auth.uid ||
          ('assistantIds' in get(/databases/$(database)/documents/teams/$(teamId)).data &&
           request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.assistantIds)
        );
      }

      // ── GAMES subcollection ──
      match /games/{gameId} {
        allow read: if true;
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/teams/$(teamId)).data.coachId == request.auth.uid ||
          ('assistantIds' in get(/databases/$(database)/documents/teams/$(teamId)).data &&
           request.auth.uid in get(/databases/$(database)/documents/teams/$(teamId)).data.assistantIds)
        );
      }

      // ── AT-BATS subcollection ──
      match /atBats/{atBatId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // ── INVITE LINKS ──
    // Anyone can read (to verify before signing in), authenticated users can create
    match /invites/{code} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // ── SCORER LINKS ──
    // Anyone can read (no login required), authenticated users can create
    match /scorerLinks/{code} {
      allow read: if true;
      allow create: if request.auth != null;
    }

    // ── FEEDBACK ──
    // Any authenticated user can submit, only you can read
    match /feedback/{docId} {
      allow create: if request.auth != null;
    }
  }
}
